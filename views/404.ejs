<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Página no encontrada | Manu Figueroa Viajes</title>
  <meta name="description" content="La página que buscas no existe. Volvé al inicio y seguí explorando nuestros paquetes turísticos.">
  <meta property="og:title" content="404 - Página no encontrada | Manu Figueroa Viajes">
  <meta property="og:description" content="La página que buscas no existe. Volvé al inicio y seguí explorando nuestros paquetes turísticos.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= siteUrl %>">
  <meta property="og:image" content="<%= siteUrl %>/images/hero.jpeg">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/fav1616.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/fav3232.png">

  <%- include('partials/google-analytics') %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles/output.css">
  <link rel="stylesheet" href="/styles/theme.css">

  <script src="/js/feather.min.js" defer></script>
</head>
<body class="font-sans bg-brand text-light">

  <%- include('partials/header') %>

  <main class="max-w-3xl mx-auto px-4 py-24 md:py-32 text-center">
    <span class="badge-accent">Error 404</span>
    <h1 class="text-7xl md:text-8xl font-bold text-accent mt-6">404</h1>
    <div class="divider mx-auto mt-4"></div>
    <h2 class="text-2xl md:text-3xl font-bold mt-8 mb-4">Página no encontrada</h2>
    <p class="text-lg opacity-90 mb-10">
      <%= (typeof message !== 'undefined' && message) ? message : 'Lo sentimos, no pudimos encontrar lo que buscas.' %>
    </p>
    <a href="/" class="btn-accent inline-flex items-center gap-2 px-8 py-3 text-base">
      <i data-feather="home" class="w-5 h-5"></i>
      Volver al inicio
    </a>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js" defer></script>
</body>
</html>
