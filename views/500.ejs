<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error del servidor | Manu Figueroa Viajes</title>
  <meta name="description" content="Ocurrió un error en el servidor. Por favor intentá nuevamente más tarde.">
  <meta property="og:title" content="Error del servidor | Manu Figueroa Viajes">
  <meta property="og:description" content="Ocurrió un error en el servidor. Por favor intentá nuevamente más tarde.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= siteUrl %>">
  <meta property="og:image" content="<%= siteUrl %>/images/hero.jpeg">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/fav1616.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/fav3232.png">

  <%- include('partials/google-analytics') %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles/output.css">
  <link rel="stylesheet" href="/styles/theme.css">

  <script src="/js/feather.min.js" defer></script>
</head>
<body class="font-sans bg-brand text-light">

  <%- include('partials/header') %>

  <main class="max-w-3xl mx-auto px-4 py-24 md:py-32 text-center">
    <span class="badge-accent">Error 500</span>
    <h1 class="text-7xl md:text-8xl font-bold text-accent mt-6">500</h1>
    <div class="divider mx-auto mt-4"></div>
    <h2 class="text-2xl md:text-3xl font-bold mt-8 mb-4">¡Ups! Algo salió mal</h2>
    <p class="text-lg opacity-90 mb-4">
      <%= (typeof message !== 'undefined' && message) ? message : 'Ocurrió un error en el servidor.' %>
    </p>
    <p class="opacity-75 mb-10">
      Por favor intentá nuevamente más tarde o volvé a la página de inicio.
    </p>
    <% if (typeof error !== 'undefined' && error) { %>
      <pre class="text-left text-xs bg-black/30 rounded-xl p-4 mb-10 overflow-auto max-h-48"><%= error.stack || error.message || error %></pre>
    <% } %>
    <a href="/" class="btn-accent inline-flex items-center gap-2 px-8 py-3 text-base">
      <i data-feather="home" class="w-5 h-5"></i>
      Volver al inicio
    </a>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js" defer></script>
</body>
</html>
